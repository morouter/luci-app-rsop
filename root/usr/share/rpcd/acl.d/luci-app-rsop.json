{
  "luci-app-rsop": {
    "description": "ACL for LuCI-APP-RSOP",
    "read": {
      "file": {
        "/etc/rustdesk/*": ["stat"],
        "/etc/rustdesk/id_ed25519.pub": ["read"],
        "/usr/bin/rsop": ["stat"],
        "/usr/bin/hbbs": ["stat"],
        "/usr/bin/hbbr": ["stat"]
      },
      "ubus": {
        "file": ["read", "stat"],
        "service": ["list"]
      }
    },
    "write": {
      "ubus": {
        "rc": ["init"]
      }
    }
  }
}
