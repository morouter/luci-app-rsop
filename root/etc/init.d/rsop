#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

DATA_DIR="/etc/rustdesk"
SERVER_BIN="/usr/bin/go-rustdesk-server"
CONFIG_FILE="$DATA_DIR/config.toml"

check_binary() {
    if [ ! -x "$1" ]; then
        echo "rsop: required executable '$1' is missing or not executable." >&2
        return 1
    fi
}

toml_escape() {
    printf '%s' "$1" | awk 'BEGIN { ORS = "" }
        { if (NR > 1) printf "\\n"
          gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\r/, "\\r"); gsub(/\t/, "\\t")
          printf "%s", $0 }'
}

toml_list_item() {
    printf '"%s", ' "$(toml_escape "$1")"
}

toml_list() {
    printf '%s = [' "$1"
    config_list_foreach main "$1" toml_list_item
    printf ']\n'
}

toml_relay_servers() {
    if [ -n "$relay_server" ]; then
        printf 'relay_servers = ["%s"]\n' "$(toml_escape "$relay_server")"
    else
        toml_list relay_servers
    fi
}

write_config() {
    local enabled listen relay_server http_port nat_port id_port relay_port
    local websocket_port web_api_port log_path log_level log_color max_size
    local max_connections max_frame_size enforce_key relay_buffer_size max_files
    local relay_servers config_serial always_use_relay udp_receive_buffer
    local single_bandwidth total_bandwidth limit_speed downgrade_threshold downgrade_start_check

    config_load rsop
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 2
    config_get listen main listen '::'
    config_get relay_server main relay_server ''
    config_get relay_servers main relay_servers ''
    if [ -n "$relay_server" ] && [ -n "$relay_servers" ]; then
        echo "rsop: use relay_server or relay_servers, not both." >&2
        return 1
    fi
    config_get config_serial main config_serial '0'
    config_get http_port main http_port '21114'
    config_get nat_port main nat_port '21115'
    config_get id_port main id_port '21116'
    config_get relay_port main relay_port '21117'
    config_get websocket_port main websocket_port '21118'
    config_get web_api_port main web_api_port '21119'
    config_get log_path main log_path 'rdks.log'
    config_get log_level main log_level 'info'
    config_get_bool log_color main log_color 0
    config_get max_size main max_size '10485760'
    config_get max_files main max_files '4'
    config_get_bool always_use_relay main always_use_relay 0
    config_get udp_receive_buffer main udp_receive_buffer '0'
    config_get single_bandwidth main single_bandwidth '0'
    config_get total_bandwidth main total_bandwidth '0'
    config_get limit_speed main limit_speed '32'
    config_get downgrade_threshold main downgrade_threshold '0.66'
    config_get downgrade_start_check main downgrade_start_check '1800'
    config_get max_connections main max_connections '4096'
    config_get max_frame_size main max_frame_size '16777216'
    config_get_bool enforce_key main enforce_key 1
    config_get relay_buffer_size main relay_buffer_size '262144'
    case "$log_path" in
        /*) ;;
        *) log_path="$DATA_DIR/$log_path" ;;
    esac

    mkdir -p "${CONFIG_FILE%/*}" "$DATA_DIR" || return 1
    umask 077
    {
        printf '[base]\n'
        printf 'listen = "%s"\n' "$(toml_escape "$listen")"
        toml_relay_servers
        toml_list rendezvous_servers
        printf 'config_serial = %s\n' "$config_serial"
        printf 'http_port = %s\n' "$http_port"
        printf 'nat_port = %s\n' "$nat_port"
        printf 'id_port = %s\n' "$id_port"
        printf 'relay_port = %s\n' "$relay_port"
        printf 'websocket_port = %s\n' "$websocket_port"
        printf 'web_api_port = %s\n' "$web_api_port"
        printf 'data_dir = "%s"\n\n' "$DATA_DIR"
        printf '[log]\n'
        printf 'log_path = "%s"\n' "$(toml_escape "$log_path")"
        printf 'log_level = "%s"\n' "$(toml_escape "$log_level")"
        [ "$log_color" -eq 1 ] && printf 'log_color = true\n' || printf 'log_color = false\n'
        printf 'max_size = %s\n' "$max_size"
        printf 'max_files = %s\n' "$max_files"
        printf '\n'
        printf '[extra]\n'
        [ "$always_use_relay" -eq 1 ] && printf 'always_use_relay = true\n' || printf 'always_use_relay = false\n'
        printf 'udp_receive_buffer = %s\n' "$udp_receive_buffer"
        printf 'single_bandwidth = %s\n' "$single_bandwidth"
        printf 'total_bandwidth = %s\n' "$total_bandwidth"
        toml_list blocklist
        toml_list blacklist
        printf 'limit_speed = %s\n' "$limit_speed"
        printf 'downgrade_threshold = %s\n' "$downgrade_threshold"
        printf 'downgrade_start_check = %s\n' "$downgrade_start_check"
        printf 'max_connections = %s\n' "$max_connections"
        printf 'max_frame_size = %s\n' "$max_frame_size"
        [ "$enforce_key" -eq 1 ] && printf 'enforce_key = true\n' || printf 'enforce_key = false\n'
        printf 'relay_buffer_size = %s\n' "$relay_buffer_size"
    } >"$CONFIG_FILE"
}

start_service() {
    write_config
    case "$?" in
        0) ;;
        2) return 0 ;;
        *) return 1 ;;
    esac
    check_binary "$SERVER_BIN" || return 1

    procd_open_instance "server"
    procd_set_param command "$SERVER_BIN" run -c "$CONFIG_FILE"
    procd_set_param respawn 3600 3 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "rsop"
}

reload_service() {
    stop
    start
}
