#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

DATA_DIR="/etc/rustdesk"
RSOP_BIN="$DATA_DIR/rsop"
HBBS_BIN="$DATA_DIR/hbbs"
HBBR_BIN="$DATA_DIR/hbbr"

check_binary() {
    if [ ! -x "$1" ]; then
        echo "rsop: required executable '$1' is missing or not executable." >&2
        return 1
    fi
}

start_service() {
    check_binary "$RSOP_BIN" || return 1
    check_binary "$HBBS_BIN" || return 1
    check_binary "$HBBR_BIN" || return 1

    procd_open_instance "rsop"
    procd_set_param command "$RSOP_BIN"
    procd_set_param respawn 3600 3 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance "hbbs"
    procd_set_param command "/bin/sh" "-c" "cd \"$DATA_DIR\" && exec \"$HBBS_BIN\""
    procd_set_param respawn 3600 3 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance "hbbr"
    procd_set_param command "/bin/sh" "-c" "cd \"$DATA_DIR\" && exec \"$HBBR_BIN\""
    procd_set_param respawn 3600 3 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
