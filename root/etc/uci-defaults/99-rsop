#!/bin/sh

mkdir -p /etc/config || exit 1
if [ ! -e /etc/config/rsop ]; then
    (umask 077; touch /etc/config/rsop) || exit 1
fi

uci -q get rsop.main >/dev/null || uci set rsop.main='rsop' || exit 1

set_default() {
    uci -q get "rsop.main.$1" >/dev/null && return 0
    uci set "rsop.main.$1=$2"
}

set_default enabled '1' || exit 1
set_default listen '::' || exit 1
set_default relay_server '' || exit 1
set_default log_path 'rdks.log' || exit 1
set_default log_level 'info' || exit 1
set_default log_color '0' || exit 1
set_default max_size '10485760' || exit 1
set_default max_connections '4096' || exit 1
set_default max_frame_size '16777216' || exit 1
set_default enforce_key '1' || exit 1
set_default relay_buffer_size '262144' || exit 1

# This setting is no longer exposed; the server default is always used.
uci -q delete rsop.main.max_files

uci commit rsop || exit 1
exit 0
