"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "Overview"
msgstr "概览"

msgid "Logs"
msgstr "日志"

msgid "Config"
msgstr "配置"

msgid "RustDesk Server Logs"
msgstr "RustDesk 服务器日志"

msgid "Log is empty."
msgstr "日志为空。"

msgid "Log file does not exist."
msgstr "日志文件不存在。"

msgid "Unknown error: %s"
msgstr "未知错误：%s"

msgid "Clear log"
msgstr "清空日志"

msgid "This will permanently erase the current log file. Continue?"
msgstr "这将永久清空当前日志文件，是否继续？"

msgid "Cancel"
msgstr "取消"

msgid "Delete"
msgstr "删除"

msgid "Failed to clear log: %s"
msgstr "清空日志失败：%s"

msgid "Refresh"
msgstr "刷新"

msgid "Export log"
msgstr "导出日志"

msgid "Failed to export log: %s"
msgstr "导出日志失败：%s"

msgid "Refresh every %s seconds."
msgstr "每 %s 秒刷新一次。"

msgid "Relay TCP Buffer Size (bytes)"
msgstr "中继 TCP 缓冲区大小（字节）"

msgid "Per-connection relay buffer. Use 0 for system automatic tuning; larger values use more memory."
msgstr "每个中继连接的缓冲区。设为 0 使用系统自动调优；数值越大占用的内存越多。"

msgid "Must be 0 or an integer between 65536 and 16777216."
msgstr "必须为 0 或 65536 至 16777216 之间的整数。"

msgid "Rustdesk Server for OpenWrt with LuCI Support."
msgstr "Rustdesk Server的OpenWrt LuCI支持。"

msgid "If you cannot connect to your RustDesk Server from the public internet, please make sure that TCP and UDP ports 21114-21119 are opened in the firewall and forwarded to this device."
msgstr "如果无法从公网访问 RustDesk 服务器，请检查 21114-21119 端口的 TCP 和 UDP 是否已在防火墙中放行，并正确转发到本设备。"

msgid "Collecting data..."
msgstr "正在收集数据..."

msgid "binary is missing"
msgstr "缺少二进制文件"

msgid "is running"
msgstr "正在运行"

msgid "is not running"
msgstr "未运行"

msgid "Server Key"
msgstr "服务器密钥"

msgid "No key yet. Start the service once to generate it."
msgstr "尚未生成密钥。请先启动一次服务以生成密钥。"

msgid "Start"
msgstr "启动"

msgid "Stop"
msgstr "停止"

msgid "Start Service"
msgstr "启动服务"

msgid "Connection Public Key"
msgstr "连接公钥"

msgid "Verify Client Key"
msgstr "校验客户端密钥"

msgid "Reject clients that do not provide the correct public key."
msgstr "拒绝未提供正确公钥的客户端。"

msgid "Copy"
msgstr "复制"

msgid "Are you sure you want to stop the RustDesk Server?"
msgstr "确定要停止 RustDesk 服务器吗？"

msgid "Service started."
msgstr "服务已启动。"

msgid "Service stopped."
msgstr "服务已停止。"

msgid "Failed to start the service."
msgstr "启动服务失败。"

msgid "Failed to stop the service."
msgstr "停止服务失败。"

msgid "Copied!"
msgstr "已复制！"

msgid "Copy failed"
msgstr "复制失败"

msgid "Loading..."
msgstr "加载中..."

msgid "RustDesk Server"
msgstr "RustDesk 服务器"

msgid "General"
msgstr "常规"

msgid "Ports"
msgstr "端口"

msgid "Logging"
msgstr "日志"

msgid "Advanced"
msgstr "高级"

msgid "Enable Service"
msgstr "启用服务"

msgid "Listen Address"
msgstr "监听地址"

msgid "Public Relay Address"
msgstr "公网中继地址"

msgid "Automatically detect when empty"
msgstr "留空时自动检测"

msgid "HTTP Compatibility Port"
msgstr "HTTP 兼容端口"

msgid "NAT Test Port"
msgstr "NAT 测试端口"

msgid "ID and Rendezvous Port"
msgstr "ID 与会合端口"

msgid "Relay Port"
msgstr "中继端口"

msgid "WebSocket Port"
msgstr "WebSocket 端口"

msgid "Web API Port"
msgstr "Web API 端口"

msgid "Log File"
msgstr "日志文件"

msgid "Log Level"
msgstr "日志等级"

msgid "Colored Logs"
msgstr "彩色日志"

msgid "Maximum Log Size (bytes)"
msgstr "日志文件最大大小（字节）"

msgid "Maximum Connections"
msgstr "最大连接数"

msgid "Maximum Frame Size (bytes)"
msgstr "最大帧大小（字节）"

msgid "Relay Policy"
msgstr "中继策略"

msgid "Client Configuration"
msgstr "客户端配置"

msgid "Use either a single relay address or a relay server list, not both."
msgstr "单个中继地址与中继服务器列表不能同时设置。"

msgid "Relay Server List"
msgstr "中继服务器列表"

msgid "Rotate through these relay endpoints. Leave the single relay address empty. IPv6 with a port must use [address]:port."
msgstr "轮询使用这些中继地址，需将单个中继地址留空。带端口的 IPv6 请使用 [地址]:端口。"

msgid "Rendezvous Server List"
msgstr "会合服务器列表"

msgid "Server list distributed to legacy clients. Increase the configuration serial after changing this list."
msgstr "下发给旧版客户端的服务器列表，修改后请增大配置序列号。"

msgid "Configuration Serial"
msgstr "配置序列号"

msgid "Always Use Relay"
msgstr "始终使用中继"

msgid "Force relay instead of direct or LAN connections, including WebSocket clients."
msgstr "强制使用中继，禁用直连和局域网连接，也适用于 WebSocket 客户端。"

msgid "Per-session Bandwidth (Mb/s)"
msgstr "每会话带宽（Mb/s）"

msgid "Shared by both directions of one session. 0 means unlimited."
msgstr "单个会话的两个传输方向共用，0 表示不限速。"

msgid "Total Bandwidth (Mb/s)"
msgstr "总带宽（Mb/s）"

msgid "Shared by all relay sessions. 0 means unlimited."
msgstr "所有中继会话共用，0 表示不限速。"

msgid "Reduced Bandwidth (Mb/s)"
msgstr "降速后带宽（Mb/s）"

msgid "Applied to the rate-limit list and automatically downgraded sessions. 0 means unlimited."
msgstr "适用于限速名单及自动降速的会话，0 表示不限速。"

msgid "Blocked Addresses"
msgstr "封禁地址"

msgid "Refuse relay for these IP addresses or CIDR networks."
msgstr "拒绝这些 IP 地址或 CIDR 网段使用中继。"

msgid "Rate-limited Addresses"
msgstr "限速地址"

msgid "Apply reduced bandwidth to these IP addresses or CIDR networks."
msgstr "对这些 IP 地址或 CIDR 网段应用降速后带宽。"

msgid "Downgrade Threshold"
msgstr "自动降速阈值"

msgid "Downgrade when lifetime average bandwidth exceeds the per-session limit multiplied by this ratio (0 to 1)."
msgstr "会话自建立以来的平均带宽超过每会话带宽限制乘以此比例时降速（0 到 1）。"

msgid "Downgrade Check Delay (seconds)"
msgstr "降速检查延迟（秒）"

msgid "Start checking after this session duration. 0 disables automatic downgrade; a per-session bandwidth limit is required."
msgstr "会话持续指定时间后开始检查。0 禁用自动降速；需设置每会话带宽限制。"

msgid "WebSocket Relay / HTTP Compatibility Port"
msgstr "WebSocket 中继 / HTTP 兼容端口"

msgid "Retained Log Files"
msgstr "保留日志文件数"

msgid "Includes the current log file. Set to 1 to keep no rotated history."
msgstr "包含当前日志文件，设为 1 不保留轮转历史。"

msgid "UDP Receive Buffer (bytes)"
msgstr "UDP 接收缓冲区（字节）"

msgid "0 keeps the operating system default."
msgstr "0 使用操作系统默认值。"
